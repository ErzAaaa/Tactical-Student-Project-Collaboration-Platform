# Data source: "mock" (localStorage + synthetic seed) or "supabase"
NEXT_PUBLIC_DATA_SOURCE=mock

# Optional Supabase (required only when NEXT_PUBLIC_DATA_SOURCE=supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional Server-side LLM for /api/match (never expose to client)
# If omitted, /api/match runs in deterministic rules-only mode
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
